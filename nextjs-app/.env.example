# AutoLawyer / DocuIntel - Environment Configuration
# Copy this file to .env.local and fill in your actual keys.
#   cp .env.example .env.local

# OpenAI (required)
OPENAI_API_KEY=
OPENAI_TOKEN_BUDGET=2000000
AUTOLAWYER_MODEL=gpt-4o-mini

# MongoDB (required)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/docuintel?retryWrites=true&w=majority

# Auth (required in production)
JWT_SECRET=your-random-secret-at-least-32-chars
AUTH_SECRET=your-random-secret-at-least-32-chars

# Google Sign-In (separate from Drive integration below)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple Sign-In
AUTH_APPLE_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=

# Stripe billing (optional - enables paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=

# Resend email (optional - enables password reset emails and notifications)
RESEND_API_KEY=
EMAIL_FROM=DocuIntel <onboarding@resend.dev>

# Google Drive import (optional — separate OAuth client from AUTH_GOOGLE_*)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DocuSign e-signatures (optional)
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=

# App URL (for email links, CORS, OAuth redirects in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo login in production (default: disabled)
# ALLOW_DEMO_LOGIN=true
# NEXT_PUBLIC_ALLOW_DEMO_LOGIN=true

# Python backend (optional - for GPU-accelerated deep analysis)
# AUTOLAWYER_PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Autonomy controls
AUTO_LAWYER_OFFLINE=0
