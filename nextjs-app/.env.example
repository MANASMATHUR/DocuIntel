# AutoLawyer / DocuIntel - Environment Configuration
# Copy this file to .env.local and fill in your actual keys.
#   cp .env.example .env.local

# OpenAI (required)
OPENAI_API_KEY=
OPENAI_TOKEN_BUDGET=2000000
AUTOLAWYER_MODEL=gpt-4o-mini

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/docuintel

# Python backend (optional - for GPU-accelerated deep analysis)
# AUTOLAWYER_PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Autonomy controls (1 = offline/mock mode, 0 = live API calls)
AUTO_LAWYER_OFFLINE=0
